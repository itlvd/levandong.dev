{
  "name": "levandong.dev (Hugo)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/hugo:1": {
      "version": "latest",
      "extended": true
    },
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "forwardPorts": [1313],
  "portsAttributes": {
    "1313": {
      "label": "Hugo",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "git submodule update --init --recursive",
  "postStartCommand": {
    "command": "hugo server --bind 0.0.0.0 --baseURL http://localhost:1313 --liveReloadPort 1313",
    "isBackground": true
  },
  "customizations": {
    "vscode": {
      "extensions": ["budparr.language-hugo-vscode"]
    }
  }
}
